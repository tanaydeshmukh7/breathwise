# Application
APP_NAME=BreatheWise API
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# Security & Auth (Change JWT_SECRET_KEY in production!)
JWT_SECRET_KEY=replace-with-a-secure-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas (PyMongo Async API)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=breathewise
DEV_MEMORY_DB_FALLBACK=true

# Active AI Provider (gemini | huggingface)
AI_PROVIDER=gemini

# Google Gemini API (Official google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_AVAILABLE_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=35

# Optional Legacy Hugging Face Inference Providers (retained for future switching)
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_FALLBACK_MODELS=Qwen/Qwen3-32B,Qwen/Qwen3-14B,Qwen/Qwen3.5-9B
HF_TIMEOUT_SECONDS=35

# Environmental Data Provider
ENVIRONMENTAL_PROVIDER=open_meteo
DEFAULT_CITY=Pune
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567

# Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=30
